APP_ENV=production
DOMAIN=karta.example.pl

POSTGRES_DB=karta_drogowa
POSTGRES_USER=karta_app
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_JWT_SECRET

# Obrazy publikowane przez GitHub Actions do GHCR.
BACKEND_IMAGE=ghcr.io/OWNER/karta-drogowa-backend:COMMIT_SHA
FRONTEND_IMAGE=ghcr.io/OWNER/karta-drogowa-frontend:COMMIT_SHA

DATABASE_URL=postgresql://karta_app:CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD@db:5432/karta_drogowa
CORS_ORIGINS=https://karta.example.pl
ALLOWED_HOSTS=karta.example.pl
